# Browser-safe Supabase configuration used by the Next.js application.
#
# Copy this file to .env.local and replace the placeholders.
# Never put a service-role key, secret key or provider API key in NEXT_PUBLIC_*.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Edge Function and provider secrets are configured separately.
# See SELF_HOSTING.md.
